--- !u!114 &1114141233
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1114141229}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9bd95c77f52d02438562392f51a7d25, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  lines:
  - speakerName: Ethan
    portrait: {fileID: -8455434932541761271, guid: e5ee4b6f877f73b4999c391fa8f7091d, type: 3}
    text: "Kim jeste\u015B?"
    duration: 2
    voice: {fileID: 8300000, guid: fa1f5bb2563c5184a81eac73d0bf1ae1, type: 3}
  - speakerName: Duszek
    portrait: {fileID: -4265788403186580881, guid: ffdd350e19aeaac4a990d1c8be9d5e6a, type: 3}
    text: "Kim\u015B kto pomo\u017Ce ci wydosta\u0107 si\u0119 z tego zamku. Tak
      si\u0119 sk\u0142ada, \u017Ce jestem jednym z mieszka\u0144c\xF3w"
    duration: 8
    voice: {fileID: 8300000, guid: acbb9f93d51f3484eacb891b353cc869, type: 3}
  - speakerName: Ethan
    portrait: {fileID: -8455434932541761271, guid: e5ee4b6f877f73b4999c391fa8f7091d, type: 3}
    text: "Tak po prostu mi pomo\u017Cesz? Nie mam nic co m\xF3g\u0142bym ci da\u0107
      w zamian"
    duration: 6
    voice: {fileID: 8300000, guid: 3169162865440b148a154e29d429884d, type: 3}
  - speakerName: Duszek
    portrait: {fileID: -4265788403186580881, guid: ffdd350e19aeaac4a990d1c8be9d5e6a, type: 3}
    text: "Masz ale jeszcze o tym nie wiesz. Chod\u017A, musimy sie spieszy\u0107"
    duration: 6
    voice: {fileID: 8300000, guid: 384cdbdab18f1f84e89b78d75e4f9fa1, type: 3}
  dialogType: 0
  skippable: 1
  destroyAfter: 1
  skipKey: 32
  blockMovement: 1
  blockAnimation: 1
  blockAttacks: 1
  blockWallSliding: 0
  restoreControlsAfter: 1
  ghost: {fileID: 8328047560654452480}
  player: {fileID: 4818354448699903062}
