  m_Name: 
  m_EditorClassIdentifier: 
  nextSceneName: Cave
  displayImage: {fileID: 1036856234}
  fadeDuration: 0.5
  skipKey: 32
  skippable: 1
  slides:
  - image: {fileID: -187597775637299878, guid: 7f6803da94ae02e489cf5c5f5bfd7988, type: 3}
    subtitle: "Zaczekaj... musz\u0119 u\u017Cyczy\u0107 ci mojej mocy, aby\u015B
      m\xF3g\u0142 przej\u015B\u0107 dalej"
    voice: {fileID: 8300000, guid: d95bb073ddf6d6842a33b19cf503f80e, type: 3}
    duration: 0
    autoDurationByAudio: 1
    enableZoom: 0
    zoomScale: 0
  - image: {fileID: 1560768403599343084, guid: a8501c237ddbed34a8d4e44d41fea144, type: 3}
    subtitle: "Moc? Do tej pory dawa\u0142em sobie rad\u0119, nie potrzebuje \u017Cadnej
      magi, z reszt\u0105 magia jest tylko w opowie\u015Bciach dla dzieci"
    voice: {fileID: 8300000, guid: 2e3a3ece280f9eb449ea6cde0500cfa4, type: 3}
    duration: 0
    autoDurationByAudio: 1
    enableZoom: 0
    zoomScale: 0
  - image: {fileID: 4402534171872736026, guid: e995b0a85e9d1b44f8f1262851763718, type: 3}
    subtitle: "Mylisz si\u0119. Potrzebujesz jej, bo to miejsce jest przesi\u0105kni\u0119te
      innym typem magii i tylko moja magia jest w stanie j\u0105 wykry\u0107"
    voice: {fileID: 8300000, guid: 232e1631c67140a4e98a756d856ab102, type: 3}
    duration: 0
    autoDurationByAudio: 1
    enableZoom: 0
    zoomScale: 0
  - image: {fileID: -9119264362171172581, guid: 7c33cf06ea403374a89d919e2cbb1295, type: 3}
    subtitle: "M\xF3g\u0142bym si\u0119 sprzecza\u0107, ale nie mam innego wyboru.
      Co mog\u0142oby mi si\u0119 sta\u0107 gorszego ni\u017C \u015Bmier\u0107?"
    voice: {fileID: 8300000, guid: 3318fa33dd5756348a9ea8ce3cd422a4, type: 3}
    duration: 0
    autoDurationByAudio: 1
    enableZoom: 0
    zoomScale: 0
  - image: {fileID: -3246563679565389917, guid: 667165ecf32c9d84fbc29e1883c30405, type: 3}
    subtitle: "Jest wiele takich rzeczy, kt\xF3re s\u0105 gorsze ni\u017C \u015Bmier\u0107.
      Przybli\u017C si\u0119 i wyci\u0105gnij r\u0119k\u0119"
    voice: {fileID: 8300000, guid: 115e39f17f189c04c92fb81eae4bf27d, type: 3}
    duration: 0
    autoDurationByAudio: 1
    enableZoom: 0
    zoomScale: 0
  - image: {fileID: -7315565432392996890, guid: b2a00ef251bc3bd428749ad9e397f475, type: 3}
    subtitle: "Ethanie pom\xF3\u017C mi..."
    voice: {fileID: 8300000, guid: 845259c9e9ecc914dab6be9a76c9544a, type: 3}
    duration: 2
    autoDurationByAudio: 0
    enableZoom: 1
    zoomScale: 1.8
